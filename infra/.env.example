# dbt
DBT_DATASET=dbt_spotify
DBT_DEV_NAME=yourname # change it to your name or initials
# Above values are used in goats_dbt/profiles.yml, to create your development database schema. e.g. dbt_spotify_elifapa

# Kafka
KAFKA_BOOTSTRAP_SERVERS=broker:29092
KAFKA_TOPIC=spotify-streaming
POLL_INTERVAL=10

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_USER=goats
POSTGRES_PASSWORD=goats
POSTGRES_DB=dbt
POSTGRES_PORT=5433

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_DEFAULT_BUCKET=spotify-data
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Spotify API
SPOTIPY_CLIENT_ID=SPOTIPY_CLIENT_ID
SPOTIPY_CLIENT_SECRET=SPOTIPY_CLIENT_SECRET
SPOTIPY_REFRESH_TOKEN=SPOTIPY_REFRESH_TOKEN
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIPY_SCOPES=user-read-recently-played user-read-currently-playing

# Airflow
AIRFLOW_UID=5000
